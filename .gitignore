# Ignore everything by default
*

# Include config directories
!CLAUDE.md
!rules/
!rules/**
!hooks/
!hooks/**
!skills/
!skills/**
!agents/
!agents/**
!commands/
!commands/**

# Exclude runtime/generated files from hooks
hooks/*.log
hooks/debug.log
hooks/todo-enforcer.config.json

# Exclude local settings (contains machine-specific paths)
settings.json
settings.local.json

# Include scripts and docs
!.gitignore
!README.md
!INSTALL.md
!install.sh
